# Copy to .env.local. Nothing here is secret — every VITE_ variable is visible
# in the browser bundle. NEVER put API keys or service-role secrets in VITE_ vars.

# Optional: URL that accepts POSTed sync items (family status, checklist changes).
# Leave empty and the app keeps everything "Saved locally" and says so honestly.
VITE_SYNC_URL=

# Optional: set to "true" to start the app in Demo Mode by default (e.g. for judging).
VITE_DEMO_DEFAULT=false
